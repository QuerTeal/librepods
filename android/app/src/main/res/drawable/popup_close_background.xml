<?xml version="1.0" encoding="utf-8"?>
<!-- The close button's glass circle, which on iOS barely shows against the card. It is smaller than
     the button, which keeps a full 44dp touch target. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/popup_close_pressed">

    <item>
        <inset android:inset="7dp">
            <shape android:shape="oval">
                <solid android:color="@color/popup_close_background" />
            </shape>
        </inset>
    </item>
</ripple>
