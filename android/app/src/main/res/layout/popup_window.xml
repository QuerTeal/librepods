<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors the iOS AirPods card (measured from iOS 26 and iPadOS 27): title and close button on top,
     the AirPods beside their case in the middle, and a ring with a percentage under each. Positions
     that depend on the card's width (the render and the rings under it) are set by PopupWindow. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/popup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/popup_scrim"
        android:importantForAccessibility="no" />

    <me.kavishdevar.librepods.presentation.overlays.PopupCardLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/popup_card_height"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/popup_shape"
        android:clickable="true"
        android:clipChildren="false"
        android:focusable="false"
        android:layoutDirection="ltr">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginStart="64dp"
            android:layout_marginEnd="64dp"
            android:ellipsize="end"
            android:firstBaselineToTopHeight="60dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/popup_text"
            android:textSize="28sp"
            tools:text="AirPods Pro" />

        <!-- 44dp to touch, drawn as the smaller glass circle iOS shows. -->
        <ImageView
            android:id="@+id/close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="21dp"
            android:layout_marginEnd="22dp"
            android:background="@drawable/popup_close_background"
            android:contentDescription="@string/popup_close"
            android:scaleType="center"
            android:src="@drawable/popup_close" />

        <!-- Everything that changes when a bud leaves or returns to the case; it fades out and back
             in around the change, as on iOS. -->
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false">

            <!-- A looping render of the AirPods beside their case while the buds are in it, and a
                 still of the buds apart beside a larger case once one is taken out. -->
            <ImageView
                android:id="@+id/spin_case"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="top|start"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

            <ImageView
                android:id="@+id/taken_out"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="top|start"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/airpods_pro3_apart_green"
                android:visibility="gone" />

            <include
                android:id="@+id/buds_column"
                layout="@layout/popup_battery_column" />

            <include
                android:id="@+id/left_column"
                layout="@layout/popup_battery_column"
                android:visibility="gone" />

            <include
                android:id="@+id/right_column"
                layout="@layout/popup_battery_column"
                android:visibility="gone" />

            <include
                android:id="@+id/case_column"
                layout="@layout/popup_battery_column" />
        </FrameLayout>

        <!-- Optimized Charge Limit, as iOS shows it under the rings while the buds are held at the
             limit: two lines and a tinted "Charge Fully Now" button. Placed by PopupWindow. -->
        <TextView
            android:id="@+id/optimized_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:alpha="0"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/optimized_charge_popup_title"
            android:textColor="@color/popup_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/optimized_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:alpha="0"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/optimized_charge_popup_subtitle"
            android:textColor="@color/popup_secondary_text"
            android:textSize="17sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/charge_fully"
            android:layout_width="match_parent"
            android:layout_height="49dp"
            android:layout_gravity="top|center_horizontal"
            android:alpha="0"
            android:background="@drawable/popup_tinted_button"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/charge_fully_now"
            android:textColor="@color/popup_green"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </me.kavishdevar.librepods.presentation.overlays.PopupCardLayout>
</FrameLayout>
